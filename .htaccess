# .htaccess - SEO and Performance Optimization for Executive Travel Wales

# Enable GZIP compression for faster loading (SEO factor)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript font/ttf font/otf image/svg+xml
</IfModule>

# Enable browser caching for better performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 month"
  ExpiresByType font/otf "access plus 1 month"
</IfModule>

# Remove ETags for better caching
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

# Remove index.html from URLs + enforce HTTPS and non-www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.executivetravel\.wales$ [NC]
  RewriteRule ^(.*)$ https://executivetravel.wales/$1 [L,R=301]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [L]
</IfModule>

# Set proper MIME types
<IfModule mod_mime.c>
  AddType application/javascript js
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddEncoding gzip svgz
</IfModule>

# Prevent hotlinking of images
<FilesMatch "\.(jpg|jpeg|png|gif)$">
  SetEnvIf Referer "^https?://([^/]+\.)?executivetravel\.wales" local_ref=1
  SetEnvIf Referer "^$" local_ref=1
  Deny from env=!local_ref
</FilesMatch>
