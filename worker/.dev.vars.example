# Copy this file to worker/.dev.vars (which is git-ignored) for `wrangler dev`.
# In production, set the secrets with `wrangler secret put NAME` instead — never
# commit real keys.

# --- Secrets (required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
RESEND_API_KEY=re_your-key-here
BOOKING_TO_EMAIL=bookings@executivetravelwales.co.uk
BOOKING_FROM_EMAIL=noreply@executivetravelwales.co.uk

# --- Config (can also live in wrangler.toml [vars]) ---
ALLOWED_ORIGINS=https://executivetravelwales.co.uk,http://localhost:5500
EMAIL_PROVIDER=resend
CLAUDE_MODEL=claude-sonnet-4-6

# --- Business facts for the system prompt (placeholders until filled in) ---
BUSINESS_TAGLINE=[TAGLINE]
BUSINESS_PHONE=[PHONE]
BUSINESS_EMAIL=[EMAIL]
BUSINESS_HOURS=[HOURS]
BUSINESS_AREAS=[AREAS_COVERED]
BUSINESS_SERVICES=[SERVICES]
BUSINESS_FLEET=[FLEET]
BUSINESS_AIRPORTS=[AIRPORTS]
BUSINESS_PRICING_POLICY=[PRICING_POLICY]
BUSINESS_BOOKING_NOTES=[BOOKING_NOTES]

# --- Per-mile pricing (NOT used in v1; stub for later) ---
# GOOGLE_MAPS_API_KEY=your-key-here
